<Project Sdk="Microsoft.NET.Sdk">
  <!-- TenantWise for Windows: WPF + WebView2 window, Microsoft sign-in (MSAL with the Windows account broker).
       Runs on .NET Framework 4.8, which is part of Windows 10/11, so nothing else needs installing.
       Build: dotnet build src/TenantWise.App/TenantWise.App.csproj -c Release -p:Version=1.0.0
       Each organization registers TenantWise in its own tenant and enters that app (client) ID at the first sign-in. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>TenantWise</AssemblyName>
    <RootNamespace>TenantWise.App</RootNamespace>
    <StartupObject>TenantWise.App.Program</StartupObject>
    <ApplicationIcon>tenantwise.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.0.0</Version>
    <Product>TenantWise</Product>
    <AssemblyTitle>TenantWise</AssemblyTitle>
    <Description>TenantWise — Azure and Entra landscape (read-only)</Description>
    <Company>Michael Ladurner</Company>
    <Copyright>© 2026 Michael Ladurner · Apache License 2.0</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.*" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.*" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TenantWise.Core\TenantWise.Core.csproj" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <EmbeddedResource Include="..\..\tenantwise.template.html" LogicalName="tenantwise.template.html" />
    <EmbeddedResource Include="..\..\lib\cytoscape.min.js" LogicalName="cytoscape.min.js" />
    <EmbeddedResource Include="..\..\lib\tenantwise-icons.js" LogicalName="tenantwise-icons.js" />
    <EmbeddedResource Include="..\..\lib\tenantwise-font.css" LogicalName="tenantwise-font.css" />
    <EmbeddedResource Include="tenantwise.ico" LogicalName="tenantwise.ico" />
  </ItemGroup>
</Project>
